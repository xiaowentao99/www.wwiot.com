<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>万维物联网 WWIOT - 智能感知新时代 | LoRa传感器 网关 云平台</title>
  <meta name="description" content="万维物联网(WWIOT)专注于低功耗无线通讯技术与工业物联网解决方案，提供LoRa传感器、LoRa网关、云平台一站式服务，让每一个工业数据可视、可控、可联动。">
  <meta name="keywords" content="LoRa传感器, LoRa网关, 物联网解决方案, 智慧水务, 智慧能源, 智慧农业, 工业物联网">
  
  <!-- Open Graph -->
  <meta property="og:title" content="万维物联网 WWIOT - 智能感知新时代">
  <meta property="og:description" content="专注于低功耗无线通讯技术，提供从传感器、网关到云平台的高性能端到端物联网解决方案">
  <meta property="og:type" content="website">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <style>
    /* ========================================
       CSS Design System - Design Tokens
       ======================================== */
    :root {
      /* Primary - 科技蓝 */
      --color-primary-50: #eff6ff;
      --color-primary-100: #dbeafe;
      --color-primary-200: #bfdbfe;
      --color-primary-300: #93c5fd;
      --color-primary-400: #60a5fa;
      --color-primary-500: #0066ff;
      --color-primary-600: #0052cc;
      --color-primary-700: #0047b3;
      --color-primary-800: #003d99;
      --color-primary-900: #1e3a8a;

      /* Secondary - 深空灰 */
      --color-secondary-50: #f8fafc;
      --color-secondary-100: #f1f5f9;
      --color-secondary-200: #e2e8f0;
      --color-secondary-300: #cbd5e1;
      --color-secondary-400: #94a3b8;
      --color-secondary-500: #64748b;
      --color-secondary-600: #475569;
      --color-secondary-700: #334155;
      --color-secondary-800: #1e293b;
      --color-secondary-900: #0f172a;

      /* Accent - 活力橙 */
      --color-accent-400: #fb923c;
      --color-accent-500: #ff6b35;
      --color-accent-600: #ea580c;

      /* Semantic */
      --color-success: #10b981;
      --color-warning: #f59e0b;
      --color-error: #ef4444;
      --color-info: #0ea5e9;

      /* Backgrounds */
      --bg-primary: #ffffff;
      --bg-secondary: #f8fafc;
      --bg-tertiary: #f1f5f9;
      --bg-dark: #0f172a;

      /* Text */
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #94a3b8;

      /* Fonts */
      --font-sans: 'Noto Sans SC', 'Inter', system-ui, -apple-system, sans-serif;
      --font-display: 'Inter', 'Noto Sans SC', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;

      /* Spacing */
      --space-1: 0.25rem;
      --space-2: 0.5rem;
      --space-3: 0.75rem;
      --space-4: 1rem;
      --space-5: 1.25rem;
      --space-6: 1.5rem;
      --space-8: 2rem;
      --space-10: 2.5rem;
      --space-12: 3rem;
      --space-16: 4rem;
      --space-20: 5rem;
      --space-24: 6rem;

      /* Shadows */
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
      --shadow-2xl: 0 25px 50px -12px rgb(0 0 0 / 0.25);

      /* Border Radius */
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 0.75rem;
      --radius-xl: 1rem;
      --radius-2xl: 1.5rem;
      --radius-full: 9999px;

      /* Transitions */
      --transition-fast: 150ms ease;
      --transition-base: 200ms ease;
      --transition-slow: 300ms ease;
      --transition-bounce: 500ms cubic-bezier(0.34, 1.56, 0.64, 1);

      /* Container */
      --container-max: 1280px;
      --container-padding: 1.5rem;
    }

    /* Dark Theme */
    [data-theme="dark"] {
      --bg-primary: #0f172a;
      --bg-secondary: #1e293b;
      --bg-tertiary: #334155;
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --color-primary-500: #3b82f6;
      --color-primary-600: #2563eb;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.3);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.4);
    }

    /* ========================================
       Base Styles
       ======================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-sans);
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text-primary);
      background-color: var(--bg-primary);
      overflow-x: hidden;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
    }

    ul, ol {
      list-style: none;
    }

    /* ========================================
       Layout
       ======================================== */
    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    .section {
      padding: var(--space-20) 0;
    }

    .section-sm {
      padding: var(--space-12) 0;
    }

    /* ========================================
       Typography
       ======================================== */
    .text-gradient {
      background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .section-label {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      background: var(--color-primary-50);
      color: var(--color-primary-600);
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: var(--radius-full);
      margin-bottom: var(--space-4);
    }

    .section-label::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--color-primary-500);
      border-radius: 50%;
    }

    .section-title {
      font-size: clamp(1.875rem, 4vw, 2.5rem);
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.2;
      margin-bottom: var(--space-4);
    }

    .section-desc {
      font-size: 1.125rem;
      color: var(--text-secondary);
      max-width: 640px;
    }

    /* ========================================
       Header / Navigation
       ======================================== */
    .header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid transparent;
      transition: all var(--transition-base);
    }

    [data-theme="dark"] .header {
      background: rgba(15, 23, 42, 0.9);
    }

    .header.scrolled {
      border-bottom-color: var(--color-secondary-200);
      box-shadow: var(--shadow-sm);
    }

    .header__container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .header__logo {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .header__logo-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700));
      border-radius: var(--radius-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 0.875rem;
    }

    .header__logo-text {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .header__logo-en {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 400;
    }

    .header__nav {
      display: none;
      gap: var(--space-1);
    }

    @media (min-width: 1024px) {
      .header__nav {
        display: flex;
      }
    }

    .header__nav-item {
      position: relative;
      padding: var(--space-2) var(--space-4);
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--text-secondary);
      border-radius: var(--radius-md);
      transition: all var(--transition-fast);
    }

    .header__nav-item:hover,
    .header__nav-item.active {
      color: var(--color-primary-600);
      background: var(--color-primary-50);
    }

    .header__actions {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .header__theme-toggle {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-lg);
      color: var(--text-secondary);
      transition: all var(--transition-fast);
    }

    .header__theme-toggle:hover {
      background: var(--color-secondary-100);
      color: var(--text-primary);
    }

    .header__cta {
      display: none;
    }

    @media (min-width: 768px) {
      .header__cta {
        display: flex;
      }
    }

    .header__mobile-toggle {
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-lg);
      color: var(--text-secondary);
    }

    @media (min-width: 1024px) {
      .header__mobile-toggle {
        display: none;
      }
    }

    /* ========================================
       Buttons
       ======================================== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      padding: 0.75rem 1.5rem;
      font-size: 0.9375rem;
      font-weight: 500;
      line-height: 1;
      border-radius: var(--radius-lg);
      transition: all var(--transition-base);
      white-space: nowrap;
    }

    .btn--primary {
      background: var(--color-primary-500);
      color: white;
      box-shadow: 0 4px 14px 0 rgb(0 102 255 / 0.4);
    }

    .btn--primary:hover {
      background: var(--color-primary-600);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px 0 rgb(0 102 255 / 0.4);
    }

    .btn--secondary {
      background: var(--bg-primary);
      color: var(--color-primary-600);
      border: 2px solid var(--color-primary-200);
    }

    .btn--secondary:hover {
      border-color: var(--color-primary-500);
      background: var(--color-primary-50);
    }

    .btn--ghost {
      background: transparent;
      color: var(--text-secondary);
    }

    .btn--ghost:hover {
      background: var(--color-secondary-100);
      color: var(--text-primary);
    }

    .btn--white {
      background: white;
      color: var(--color-primary-600);
    }

    .btn--white:hover {
      background: var(--color-secondary-50);
      transform: translateY(-2px);
    }

    .btn--lg {
      padding: 1rem 2rem;
      font-size: 1rem;
    }

    .btn--sm {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }

    .btn--icon {
      width: 40px;
      height: 40px;
      padding: 0;
      border-radius: var(--radius-lg);
    }

    /* ========================================
       Hero Section
       ======================================== */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 72px;
      overflow: hidden;
      background: linear-gradient(180deg, var(--color-primary-50) 0%, var(--bg-primary) 100%);
    }

    [data-theme="dark"] .hero {
      background: linear-gradient(180deg, #1e293b 0%, var(--bg-primary) 100%);
    }

    .hero__bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(var(--color-secondary-200) 1px, transparent 1px),
        linear-gradient(90deg, var(--color-secondary-200) 1px, transparent 1px);
      background-size: 60px 60px;
      opacity: 0.5;
    }

    [data-theme="dark"] .hero__grid {
      background-image: 
        linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    }

    .hero__glow {
      position: absolute;
      width: 800px;
      height: 800px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--color-primary-200) 0%, transparent 70%);
      top: -200px;
      right: -200px;
      opacity: 0.6;
      animation: float 20s ease-in-out infinite;
    }

    [data-theme="dark"] .hero__glow {
      background: radial-gradient(circle, var(--color-primary-900) 0%, transparent 70%);
      opacity: 0.3;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-50px, 50px); }
    }

    .hero__shapes {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    .hero__shape {
      position: absolute;
      border-radius: 50%;
      opacity: 0.1;
      animation: pulse 4s ease-in-out infinite;
    }

    .hero__shape:nth-child(1) {
      width: 300px;
      height: 300px;
      background: var(--color-primary-500);
      top: 10%;
      right: 15%;
      animation-delay: 0s;
    }

    .hero__shape:nth-child(2) {
      width: 200px;
      height: 200px;
      background: var(--color-accent-500);
      bottom: 20%;
      left: 10%;
      animation-delay: 1s;
    }

    .hero__shape:nth-child(3) {
      width: 150px;
      height: 150px;
      background: var(--color-info);
      top: 40%;
      left: 30%;
      animation-delay: 2s;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 0.1; }
      50% { transform: scale(1.1); opacity: 0.2; }
    }

    .hero__container {
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .hero__badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      background: white;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-md);
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: var(--space-8);
      animation: fadeInUp 0.6s ease forwards;
    }

    [data-theme="dark"] .hero__badge {
      background: var(--bg-secondary);
    }

    .hero__badge-dot {
      width: 8px;
      height: 8px;
      background: var(--color-success);
      border-radius: 50%;
      animation: blink 2s infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .hero__title {
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 700;
      line-height: 1.1;
      color: var(--text-primary);
      margin-bottom: var(--space-6);
      animation: fadeInUp 0.6s ease 0.1s forwards;
      opacity: 0;
    }

    .hero__title-accent {
      position: relative;
      display: inline;
    }

    .hero__title-accent::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 8px;
      background: var(--color-primary-200);
      z-index: -1;
      transform: skewX(-3deg);
    }

    .hero__subtitle {
      font-size: clamp(1.125rem, 2vw, 1.375rem);
      color: var(--text-secondary);
      max-width: 720px;
      margin: 0 auto var(--space-8);
      animation: fadeInUp 0.6s ease 0.2s forwards;
      opacity: 0;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-4);
      margin-bottom: var(--space-16);
      animation: fadeInUp 0.6s ease 0.3s forwards;
      opacity: 0;
    }

    .hero__scroll {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
      color: var(--text-muted);
      font-size: 0.875rem;
      animation: fadeInUp 0.6s ease 0.4s forwards;
      opacity: 0;
    }

    .hero__scroll-icon {
      width: 24px;
      height: 40px;
      border: 2px solid var(--color-secondary-300);
      border-radius: 12px;
      position: relative;
    }

    .hero__scroll-dot {
      width: 4px;
      height: 8px;
      background: var(--color-primary-500);
      border-radius: 2px;
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      animation: scrollDown 2s ease-in-out infinite;
    }

    @keyframes scrollDown {
      0%, 100% { top: 8px; opacity: 1; }
      50% { top: 20px; opacity: 0.3; }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ========================================
       Stats Section
       ======================================== */
    .stats {
      padding: var(--space-16) 0;
      background: var(--bg-primary);
      position: relative;
      margin-top: -80px;
      z-index: 10;
    }

    .stats__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }

    @media (min-width: 768px) {
      .stats__grid {
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-6);
      }
    }

    .stats__card {
      background: white;
      padding: var(--space-6);
      border-radius: var(--radius-xl);
      text-align: center;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--color-secondary-100);
      transition: all var(--transition-base);
    }

    [data-theme="dark"] .stats__card {
      background: var(--bg-secondary);
      border-color: var(--color-secondary-700);
    }

    .stats__card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-xl);
    }

    .stats__icon {
      width: 48px;
      height: 48px;
      margin: 0 auto var(--space-4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .stats__value {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--color-primary-600);
      line-height: 1;
      margin-bottom: var(--space-2);
    }

    .stats__label {
      font-size: 0.875rem;
      color: var(--text-secondary);
      font-weight: 500;
    }

    /* ========================================
       Data Flow Section
       ======================================== */
    .dataflow {
      padding: var(--space-24) 0;
      background: var(--bg-secondary);
    }

    .dataflow__header {
      text-align: center;
      margin-bottom: var(--space-16);
    }

    .dataflow__visual {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-8);
    }

    @media (min-width: 768px) {
      .dataflow__visual {
        flex-direction: row;
        justify-content: center;
        gap: var(--space-4);
      }
    }

    .dataflow__step {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-4);
      padding: var(--space-6);
    }

    .dataflow__step-icon {
      width: 100px;
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-2xl);
      font-size: 2.5rem;
      position: relative;
      transition: all var(--transition-base);
    }

    .dataflow__step:nth-child(1) .dataflow__step-icon {
      background: linear-gradient(135deg, #dbeafe, #bfdbfe);
      color: var(--color-primary-600);
    }

    .dataflow__step:nth-child(3) .dataflow__step-icon {
      background: linear-gradient(135deg, #cffafe, #a5f3fc);
      color: #0891b2;
    }

    .dataflow__step:nth-child(5) .dataflow__step-icon {
      background: linear-gradient(135deg, #fce7f3, #fbcfe8);
      color: #db2777;
    }

    .dataflow__step:nth-child(7) .dataflow__step-icon {
      background: linear-gradient(135deg, #dcfce7, #bbf7d0);
      color: #16a34a;
    }

    .dataflow__step:hover .dataflow__step-icon {
      transform: scale(1.1);
    }

    .dataflow__step-number {
      position: absolute;
      top: -8px;
      right: -8px;
      width: 28px;
      height: 28px;
      background: var(--color-primary-500);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .dataflow__step-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    .dataflow__step-desc {
      font-size: 0.875rem;
      color: var(--text-secondary);
      max-width: 160px;
    }

    .dataflow__arrow {
      display: none;
    }

    @media (min-width: 768px) {
      .dataflow__arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 40px;
        color: var(--color-secondary-400);
      }
    }

    /* ========================================
       Products Section
       ======================================== */
    .products {
      padding: var(--space-24) 0;
      background: var(--bg-primary);
    }

    .products__header {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    @media (min-width: 768px) {
      .products__header {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-end;
      }
    }

    .products__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    @media (min-width: 640px) {
      .products__grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .products__grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .product-card {
      background: white;
      border-radius: var(--radius-xl);
      overflow: hidden;
      border: 1px solid var(--color-secondary-100);
      transition: all var(--transition-base);
      cursor: pointer;
    }

    [data-theme="dark"] .product-card {
      background: var(--bg-secondary);
      border-color: var(--color-secondary-700);
    }

    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow-xl);
      border-color: var(--color-primary-200);
    }

    .product-card__image {
      aspect-ratio: 4/3;
      background: linear-gradient(135deg, var(--color-primary-50), var(--bg-secondary));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4rem;
      position: relative;
      overflow: hidden;
    }

    .product-card__image::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: linear-gradient(to top, white, transparent);
    }

    [data-theme="dark"] .product-card__image::after {
      background: linear-gradient(to top, var(--bg-secondary), transparent);
    }

    .product-card__content {
      padding: var(--space-5);
    }

    .product-card__title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: var(--space-2);
    }

    .product-card__desc {
      font-size: 0.875rem;
      color: var(--text-secondary);
      margin-bottom: var(--space-4);
      line-height: 1.5;
    }

    .product-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }

    .product-card__tag {
      padding: var(--space-1) var(--space-3);
      background: var(--color-primary-50);
      color: var(--color-primary-600);
      font-size: 0.75rem;
      font-weight: 500;
      border-radius: var(--radius-full);
    }

    .product-card__link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-primary-600);
      font-size: 0.875rem;
      font-weight: 500;
      transition: all var(--transition-fast);
    }

    .product-card__link:hover {
      gap: var(--space-3);
    }

    .product-card__link svg {
      transition: transform var(--transition-fast);
    }

    .product-card:hover .product-card__link svg {
      transform: translateX(4px);
    }

    /* ========================================
       Solutions Section
       ======================================== */
    .solutions {
      padding: var(--space-24) 0;
      background: var(--bg-secondary);
    }

    .solutions__header {
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .solutions__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    @media (min-width: 640px) {
      .solutions__grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .solutions__grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .solution-card {
      position: relative;
      min-height: 320px;
      border-radius: var(--radius-xl);
      overflow: hidden;
      cursor: pointer;
      transition: all var(--transition-base);
    }

    .solution-card:hover {
      transform: translateY(-8px);
    }

    .solution-card__bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      transition: transform var(--transition-slow);
    }

    .solution-card:nth-child(1) .solution-card__bg {
      background: linear-gradient(135deg, #0ea5e9, #0284c7);
    }

    .solution-card:nth-child(2) .solution-card__bg {
      background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .solution-card:nth-child(3) .solution-card__bg {
      background: linear-gradient(135deg, #10b981, #059669);
    }

    .solution-card:nth-child(4) .solution-card__bg {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
    }

    .solution-card:hover .solution-card__bg {
      transform: scale(1.1);
    }

    .solution-card__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(15, 23, 42, 0.95) 0%,
        rgba(15, 23, 42, 0.6) 50%,
        rgba(15, 23, 42, 0.3) 100%
      );
    }

    .solution-card__content {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: var(--space-6);
      color: white;
    }

    .solution-card__icon {
      font-size: 3rem;
      margin-bottom: var(--space-4);
    }

    .solution-card__title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--space-3);
    }

    .solution-card__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }

    .solution-card__item {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      opacity: 0.9;
    }

    .solution-card__item::before {
      content: '→';
      font-weight: 700;
    }

    .solution-card__link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      background: white;
      color: var(--text-primary);
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: var(--radius-lg);
      transition: all var(--transition-fast);
    }

    .solution-card:hover .solution-card__link {
      background: white;
      color: var(--color-primary-600);
    }

    /* ========================================
       Features Section
       ======================================== */
    .features {
      padding: var(--space-24) 0;
      background: var(--bg-primary);
    }

    .features__header {
      text-align: center;
      margin-bottom: var(--space-16);
    }

    .features__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    @media (min-width: 768px) {
      .features__grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .features__grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .feature-card {
      text-align: center;
      padding: var(--space-8);
      background: white;
      border-radius: var(--radius-xl);
      border: 1px solid var(--color-secondary-100);
      transition: all var(--transition-base);
    }

    [data-theme="dark"] .feature-card {
      background: var(--bg-secondary);
      border-color: var(--color-secondary-700);
    }

    .feature-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--color-primary-200);
    }

    .feature-card__icon {
      width: 80px;
      height: 80px;
      margin: 0 auto var(--space-6);
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-2xl);
      font-size: 2.5rem;
    }

    .feature-card:nth-child(1) .feature-card__icon {
      background: linear-gradient(135deg, #fef3c7, #fde68a);
    }

    .feature-card:nth-child(2) .feature-card__icon {
      background: linear-gradient(135deg, #dbeafe, #bfdbfe);
    }

    .feature-card:nth-child(3) .feature-card__icon {
      background: linear-gradient(135deg, #dcfce7, #bbf7d0);
    }

    .feature-card:nth-child(4) .feature-card__icon {
      background: linear-gradient(135deg, #f3e8ff, #e9d5ff);
    }

    .feature-card__title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: var(--space-2);
    }

    .feature-card__highlight {
      display: inline-block;
      font-size: 2rem;
      font-weight: 700;
      color: var(--color-primary-600);
      margin-bottom: var(--space-3);
    }

    .feature-card__desc {
      font-size: 0.9375rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    /* ========================================
       CTA Section
       ======================================== */
    .cta {
      padding: var(--space-24) 0;
      background: linear-gradient(135deg, var(--color-primary-600), var(--color-primary-800));
      color: white;
      position: relative;
      overflow: hidden;
    }

    .cta::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(255,255,255,0.1), transparent 70%);
      border-radius: 50%;
    }

    .cta::after {
      content: '';
      position: absolute;
      bottom: -30%;
      left: -10%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(255,255,255,0.05), transparent 70%);
      border-radius: 50%;
    }

    .cta__container {
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .cta__title {
      font-size: clamp(1.875rem, 4vw, 2.5rem);
      font-weight: 700;
      margin-bottom: var(--space-4);
    }

    .cta__desc {
      font-size: 1.125rem;
      opacity: 0.9;
      max-width: 600px;
      margin: 0 auto var(--space-8);
    }

    .cta__actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-4);
    }

    /* ========================================
       Footer
       ======================================== */
    .footer {
      background: var(--bg-secondary);
      padding: var(--space-16) 0 var(--space-8);
      border-top: 1px solid var(--color-secondary-200);
    }

    [data-theme="dark"] .footer {
      background: var(--bg-dark);
      border-color: var(--color-secondary-700);
    }

    .footer__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-10);
      margin-bottom: var(--space-12);
    }

    @media (min-width: 768px) {
      .footer__grid {
        grid-template-columns: 2fr repeat(3, 1fr);
      }
    }

    .footer__brand {
      max-width: 300px;
    }

    .footer__logo {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-4);
    }

    .footer__logo-icon {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700));
      border-radius: var(--radius-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 0.75rem;
    }

    .footer__desc {
      font-size: 0.875rem;
      color: var(--text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-6);
    }

    .footer__social {
      display: flex;
      gap: var(--space-3);
    }

    .footer__social-link {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-lg);
      background: var(--color-secondary-100);
      color: var(--text-secondary);
      transition: all var(--transition-fast);
    }

    .footer__social-link:hover {
      background: var(--color-primary-500);
      color: white;
    }

    .footer__column-title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: var(--space-5);
    }

    .footer__links {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .footer__link {
      font-size: 0.875rem;
      color: var(--text-secondary);
      transition: color var(--transition-fast);
    }

    .footer__link:hover {
      color: var(--color-primary-600);
    }

    .footer__bottom {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-secondary-200);
      text-align: center;
    }

    @media (min-width: 768px) {
      .footer__bottom {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }

    .footer__copyright {
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .footer__legal {
      display: flex;
      gap: var(--space-6);
    }

    .footer__legal-link {
      font-size: 0.875rem;
      color: var(--text-muted);
      transition: color var(--transition-fast);
    }

    .footer__legal-link:hover {
      color: var(--color-primary-600);
    }

    /* ========================================
       Mobile Menu
       ======================================== */
    .mobile-menu {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-width: 320px;
      background: var(--bg-primary);
      box-shadow: var(--shadow-2xl);
      z-index: 2000;
      transform: translateX(100%);
      transition: transform var(--transition-base);
    }

    .mobile-menu.open {
      transform: translateX(0);
    }

    .mobile-menu__overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1999;
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition-base);
    }

    .mobile-menu__overlay.open {
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-4) var(--space-6);
      border-bottom: 1px solid var(--color-secondary-200);
    }

    .mobile-menu__close {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-lg);
      color: var(--text-secondary);
    }

    .mobile-menu__nav {
      padding: var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .mobile-menu__item {
      padding: var(--space-4);
      font-size: 1rem;
      font-weight: 500;
      color: var(--text-secondary);
      border-radius: var(--radius-lg);
      transition: all var(--transition-fast);
    }

    .mobile-menu__item:hover,
    .mobile-menu__item.active {
      background: var(--color-primary-50);
      color: var(--color-primary-600);
    }

    /* ========================================
       Utilities
       ======================================== */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    /* Scroll animations */
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.6s ease;
    }

    .animate-on-scroll.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Icon SVG */
    .icon {
      width: 24px;
      height: 24px;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header class="header" id="header">
    <div class="container header__container">
      <!-- Logo -->
      <a href="/" class="header__logo">
        <img src="images/logo.png" alt="万维物联网 WWIOT" class="header__logo-img" style="height: 40px;">
        <div class="header__logo-text">
          <span>万维物联网</span>
          <span class="header__logo-en">WWIOT</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="header__nav">
        <a href="#" class="header__nav-item active">首页</a>
        <a href="#products" class="header__nav-item">产品中心</a>
        <a href="#solutions" class="header__nav-item">解决方案</a>
        <a href="#" class="header__nav-item">技术支持</a>
        <a href="#" class="header__nav-item">关于我们</a>
      </nav>

      <!-- Actions -->
      <div class="header__actions">
        <button class="header__theme-toggle" id="themeToggle" aria-label="切换主题">
          <svg class="icon" viewBox="0 0 24 24" id="sunIcon">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>

        <a href="contact.html" class="btn btn--primary header__cta">联系我们</a>

        <button class="header__mobile-toggle" id="mobileToggle" aria-label="打开菜单">
          <svg class="icon" viewBox="0 0 24 24">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div class="mobile-menu__overlay" id="mobileOverlay"></div>
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu__header">
      <span class="header__logo-text" style="font-weight: 600;">菜单</span>
      <button class="mobile-menu__close" id="mobileClose">
        <svg class="icon" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <nav class="mobile-menu__nav">
      <a href="#" class="mobile-menu__item active">首页</a>
      <a href="#products" class="mobile-menu__item">产品中心</a>
      <a href="#solutions" class="mobile-menu__item">解决方案</a>
      <a href="#" class="mobile-menu__item">技术支持</a>
      <a href="#" class="mobile-menu__item">关于我们</a>
      <a href="contact.html" class="btn btn--primary" style="margin-top: 1rem;">联系我们</a>
    </nav>
  </div>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__grid"></div>
      <div class="hero__glow"></div>
      <div class="hero__shapes">
        <div class="hero__shape"></div>
        <div class="hero__shape"></div>
        <div class="hero__shape"></div>
      </div>
    </div>

    <div class="container hero__container">
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        <span>LoRa技术 · 10年深耕 · 1000+客户信赖</span>
      </div>

      <h1 class="hero__title">
        智能感知新时代<br>
        <span class="text-gradient">连接万物，感知未来</span>
      </h1>

      <p class="hero__subtitle">
        专注于低功耗无线通讯技术与工业物联网解决方案，<br>
        提供从传感器、网关到云平台的高性能端到端服务
      </p>

      <div class="hero__actions">
        <a href="#products" class="btn btn--primary btn--lg">
          探索产品
          <svg class="icon" viewBox="0 0 24 24" style="width: 20px; height: 20px;">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="contact.html" class="btn btn--secondary btn--lg">联系我们</a>
        <a href="#solutions" class="btn btn--ghost btn--lg">
          <svg class="icon" viewBox="0 0 24 24" style="width: 20px; height: 20px;">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          查看演示
        </a>
      </div>

      <div class="hero__scroll">
        <div class="hero__scroll-icon">
          <div class="hero__scroll-dot"></div>
        </div>
        <span>向下滚动</span>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats">
    <div class="container">
      <div class="stats__grid">
        <div class="stats__card animate-on-scroll">
          <div class="stats__icon">🏆</div>
          <div class="stats__value">10+</div>
          <div class="stats__label">年行业经验</div>
        </div>
        <div class="stats__card animate-on-scroll">
          <div class="stats__icon">📦</div>
          <div class="stats__value">50+</div>
          <div class="stats__label">产品型号</div>
        </div>
        <div class="stats__card animate-on-scroll">
          <div class="stats__icon">🤝</div>
          <div class="stats__value">1000+</div>
          <div class="stats__label">客户案例</div>
        </div>
        <div class="stats__card animate-on-scroll">
          <div class="stats__icon">🌍</div>
          <div class="stats__value">20+</div>
          <div class="stats__label">国家地区</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Data Flow Section -->
  <section class="dataflow section">
    <div class="container">
